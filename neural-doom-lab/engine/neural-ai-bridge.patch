diff --git a/src/doom/p_neural_ai.c b/src/doom/p_neural_ai.c
new file mode 100644
index 0000000000000000000000000000000000000000..1f0e297cc93f1732bc5af554fc1c3be1ff169a87
--- /dev/null
+++ b/src/doom/p_neural_ai.c
@@ -0,0 +1,147 @@
+#include "doomdef.h"
+#include "p_local.h"
+#include "p_neural_ai.h"
+#include "r_state.h"
+
+#ifdef EMSCRIPTEN
+#include <emscripten.h>
+
+EM_JS(int, NAI_JsRequestDecision,
+      (int npc_id, int npc_type, int health, int max_health, int x, int y,
+       int angle, int player_distance, int player_visible, int current_state),
+{
+    const bridge = globalThis.doomNeuralAIBridge;
+
+    if (!bridge || typeof bridge.decide !== 'function') {
+        return -1;
+    }
+
+    try {
+        const decision = bridge.decide({
+            npc_id: npc_id >>> 0,
+            npc_type,
+            health,
+            max_health,
+            position: { x, y },
+            angle: angle >>> 0,
+            player_distance,
+            player_visible: Boolean(player_visible),
+            current_state: Math.max(0, current_state),
+        });
+
+        return Number.isInteger(decision) ? decision : -1;
+    } catch (error) {
+        bridge.reportError?.(error);
+        return -1;
+    }
+});
+
+EM_JS(void, NAI_JsReportResult, (int npc_id, int action, int applied),
+{
+    globalThis.doomNeuralAIBridge?.receiveResult?.({
+        npc_id: npc_id >>> 0,
+        action,
+        applied: Boolean(applied),
+    });
+});
+
+EM_JS(void, NAI_JsReportCombatEvent, (int npc_id, int event_type, int value),
+{
+    const eventTypes = ['PLAYER_DAMAGE', 'PLAYER_KILL', 'NPC_DAMAGE', 'NPC_DEATH'];
+    const mappedEvent = eventTypes[event_type];
+
+    if (mappedEvent) {
+        globalThis.doomNeuralAIBridge?.reportCombatEvent?.({
+            npc_id: npc_id >>> 0,
+            event_type: mappedEvent,
+            value,
+        });
+    }
+});
+#endif
+
+static neural_ai_mode_t ai_mode = ORIGINAL_AI;
+
+#ifdef EMSCRIPTEN
+EMSCRIPTEN_KEEPALIVE void DB_SetAIMode(int mode)
+{
+    NAI_SetMode(mode == EXTERNAL_AI ? EXTERNAL_AI : ORIGINAL_AI);
+}
+
+EMSCRIPTEN_KEEPALIVE int DB_GetAIMode(void)
+{
+    return (int) NAI_GetMode();
+}
+#endif
+
+void NAI_SetMode(neural_ai_mode_t mode)
+{
+    ai_mode = mode == EXTERNAL_AI ? EXTERNAL_AI : ORIGINAL_AI;
+}
+
+neural_ai_mode_t NAI_GetMode(void)
+{
+    return ai_mode;
+}
+
+neural_ai_action_t NAI_RequestDecision(mobj_t *actor)
+{
+#ifdef EMSCRIPTEN
+    fixed_t distance;
+    int visible;
+    int state_index;
+    int decision;
+
+    if (ai_mode != EXTERNAL_AI || actor == NULL || actor->target == NULL)
+        return NAI_ACTION_INVALID;
+
+    distance = P_AproxDistance(actor->target->x - actor->x,
+                               actor->target->y - actor->y);
+    visible = P_CheckSight(actor, actor->target);
+    state_index = actor->state != NULL ? (int) (actor->state - states) : 0;
+
+    decision = NAI_JsRequestDecision(
+        (int) actor->neural_instance_id,
+        (int) actor->type,
+        actor->health,
+        actor->info->spawnhealth,
+        actor->x >> FRACBITS,
+        actor->y >> FRACBITS,
+        (int) actor->angle,
+        distance >> FRACBITS,
+        visible,
+        state_index
+    );
+
+    if (decision < NAI_ACTION_IDLE || decision > NAI_ACTION_FLEE)
+        return NAI_ACTION_INVALID;
+
+    return (neural_ai_action_t) decision;
+#else
+    (void) actor;
+    return NAI_ACTION_INVALID;
+#endif
+}
+
+void NAI_ReportResult(mobj_t *actor, neural_ai_action_t action, boolean applied)
+{
+#ifdef EMSCRIPTEN
+    NAI_JsReportResult((int) actor->neural_instance_id, (int) action, applied);
+#else
+    (void) actor;
+    (void) action;
+    (void) applied;
+#endif
+}
+
+void NAI_ReportCombatEvent(mobj_t *actor, neural_ai_event_t event_type, int value)
+{
+#ifdef EMSCRIPTEN
+    if (actor != NULL && actor->neural_controlled && value > 0)
+        NAI_JsReportCombatEvent((int) actor->neural_instance_id, (int) event_type, value);
+#else
+    (void) actor;
+    (void) event_type;
+    (void) value;
+#endif
+}
diff --git a/src/doom/p_neural_ai.h b/src/doom/p_neural_ai.h
new file mode 100644
index 0000000000000000000000000000000000000000..04bd45e6e5cb345062e03c5d52ba639802029428
--- /dev/null
+++ b/src/doom/p_neural_ai.h
@@ -0,0 +1,35 @@
+#ifndef DOOM_P_NEURAL_AI_H
+#define DOOM_P_NEURAL_AI_H
+
+#include "p_mobj.h"
+
+typedef enum
+{
+    ORIGINAL_AI = 0,
+    EXTERNAL_AI = 1
+} neural_ai_mode_t;
+
+typedef enum
+{
+    NAI_ACTION_INVALID = -1,
+    NAI_ACTION_IDLE = 0,
+    NAI_ACTION_CHASE = 1,
+    NAI_ACTION_ATTACK = 2,
+    NAI_ACTION_FLEE = 3
+} neural_ai_action_t;
+
+typedef enum
+{
+    NAI_EVENT_PLAYER_DAMAGE = 0,
+    NAI_EVENT_PLAYER_KILL = 1,
+    NAI_EVENT_NPC_DAMAGE = 2,
+    NAI_EVENT_NPC_DEATH = 3
+} neural_ai_event_t;
+
+void NAI_SetMode(neural_ai_mode_t mode);
+neural_ai_mode_t NAI_GetMode(void);
+neural_ai_action_t NAI_RequestDecision(mobj_t *actor);
+void NAI_ReportResult(mobj_t *actor, neural_ai_action_t action, boolean applied);
+void NAI_ReportCombatEvent(mobj_t *actor, neural_ai_event_t event_type, int value);
+
+#endif
