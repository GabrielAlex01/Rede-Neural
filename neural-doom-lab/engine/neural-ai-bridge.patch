     // do not attack twice in a row
     if (actor->flags & MF_JUSTATTACKED)
@@ -767,6 +784,56 @@ void A_Chase (mobj_t*	actor)
     }
 }
 
+static boolean NAI_ApplyDecision(mobj_t *actor, neural_ai_action_t action)
+{
+    angle_t flee_angle;
+
+    switch (action)
+    {
+        case NAI_ACTION_IDLE:
+            actor->movedir = DI_NODIR;
+            actor->movecount = 0;
+            actor->momx = 0;
+            actor->momy = 0;
+            return true;
+
+        case NAI_ACTION_CHASE:
+            if (--actor->movecount < 0 || !P_Move(actor))
+                P_NewChaseDir(actor);
+            return true;
+
+        case NAI_ACTION_ATTACK:
+            /* Preserve the ORIGINAL_AI one-shot missile cooldown. */
+            if (actor->flags & MF_JUSTATTACKED)
+                return false;
+
+            if (actor->info->meleestate && P_CheckMeleeRange(actor))
+            {
+                if (actor->info->attacksound)
+                    S_StartSound(actor, actor->info->attacksound);
+                P_SetMobjState(actor, actor->info->meleestate);
+                return true;
+            }
+            if (actor->info->missilestate && P_CheckMissileRange(actor))
+            {
+                P_SetMobjState(actor, actor->info->missilestate);
+                actor->flags |= MF_JUSTATTACKED;
+                return true;
+            }
+            return false;
+
+        case NAI_ACTION_FLEE:
+            flee_angle = R_PointToAngle2(actor->target->x, actor->target->y,
+                                         actor->x, actor->y);
+            actor->movedir = (int) (flee_angle >> 29) & 7;
+            actor->angle = flee_angle;
+            return P_Move(actor);
+
+        default:
+            return false;
+    }
+}
+
 
